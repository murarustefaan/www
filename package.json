{
	"name": "www",
	"type": "module",
	"version": "2026.14.0",
	"packageManager": "pnpm@11.28.9",
	"private": false,
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"lint": "biome lint .",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"check": "astro check",
		"test": "vitest run"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.5",
		"@astrojs/mdx": "8.1.2",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.4",
		"@fontsource-variable/hanken-grotesk": "5.3.0",
		"@fontsource-variable/martian-mono": "5.3.0",
		"@tailwindcss/vite": "4.3.3",
		"astro": "7.4.3",
		"astro-expressive-code": "^0.44.3",
		"astro-mermaid": "^2.2.0",
		"cssnano": "^9.9.0",
		"hastscript": "^9.0.1",
		"mdast-util-directive": "^3.1.1",
		"mdast-util-to-markdown": "^2.2.1",
		"mdast-util-to-string": "^4.0.0",
		"mermaid": "^12.2.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-unwrap-images": "^1.0.0",
		"remark-directive": "^4.0.0",
		"satori": "0.63.2",
		"satori-html": "^0.3.2",
		"sharp": "^0.35.5",
		"three": "0.186.1",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.2.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@biomejs/biome": "^2.6.3",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/typography": "^0.5.20",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/three": "0.186.0",
		"autoprefixer": "^10.6.2",
		"mdast-util-to-hast": "^13.2.1",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "1.1.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"reading-time": "^1.5.0",
		"tailwindcss": "4.3.3",
		"typescript": "^6.0.3",
		"vitest": "5.0.5"
	}
}
