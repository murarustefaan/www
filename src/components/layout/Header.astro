---
import { menuLinks } from "@/site.config";

const currentPath = Astro.url.pathname;
const isCurrent = (path: string) =>
	!path.includes("?") && (currentPath === path || currentPath.startsWith(`${path}/`));
---

<header>
	<div
		class="mx-auto flex max-w-6xl flex-wrap items-baseline justify-between gap-x-5 gap-y-1 px-4 py-6 font-mono text-meta sm:px-6 lg:px-8"
	>
		<a href="/" class="-my-3 py-3 transition-colors hover:text-primary">
			<span class="text-mark" aria-hidden="true">x</span> ștefan muraru
		</a>
		<nav aria-label="Main">
			<ul class="flex flex-wrap items-baseline gap-x-5">
				{
					menuLinks.map((link) => (
						<li>
							<a
								href={link.path}
								class="link aria-[current=page]:text-primary"
								aria-current={isCurrent(link.path) ? "page" : undefined}
							>
								{link.title}
							</a>
						</li>
					))
				}
				<li>
					<button
						type="button"
						id="search-trigger"
						class="link cursor-pointer"
						aria-label="Search posts (⌘K)"
					>
						search
					</button>
				</li>
			</ul>
		</nav>
	</div>
</header>
