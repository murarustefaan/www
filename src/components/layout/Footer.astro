---
import SocialList from "@/components/SocialList.astro";
import { menuLinks, siteConfig } from "@/site.config";

const year = new Date().getFullYear();
const isHome = Astro.url.pathname === "/";
---

<footer class="mt-24 border-t border-border">
	<div
		class="mx-auto flex max-w-6xl flex-wrap items-baseline justify-between gap-x-8 gap-y-4 px-4 py-10 font-mono text-meta text-muted sm:px-6 lg:px-8"
	>
		<p>&copy; {year} {siteConfig.author}</p>
		<div class="flex flex-wrap gap-x-5 gap-y-2">
			<ul class="flex flex-wrap gap-x-5 gap-y-2">
				{
					menuLinks.map((link) => (
						<li>
							<a href={link.path} class="link">
								{link.title}
							</a>
						</li>
					))
				}
				<li><a href="/rss.xml" class="link">rss</a></li>
			</ul>
			{!isHome && <SocialList />}
		</div>
	</div>
</footer>
