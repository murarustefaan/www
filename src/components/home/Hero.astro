---
import SocialList from "@/components/SocialList.astro";
import { IASI_TIME_ZONE, NIGHT_FROM, NIGHT_UNTIL } from "@/utils/iasi-time";

const alt = {
	day: "Ștefan typing at his desk; his white cat watches from the desk and his tuxedo cat from a cat tree.",
	night: "Ștefan asleep in bed with his two cats curled up on the red duvet.",
};
const still = { width: 1200, height: 900 };
const control =
	"size-11 cursor-pointer items-center justify-center rounded-full text-text transition-colors hover:text-primary";
---

<section class="grid items-center gap-x-[clamp(16px,4vw,48px)] gap-y-8 pt-6 sm:grid-cols-2 sm:pt-16">
	<div class="min-w-0">
		<h1
			class="font-mono text-name font-[250] tracking-[-0.02em] [font-stretch:87.5%] [word-spacing:-0.25em] min-[1000px]:font-extralight"
		>
			Ștefan Muraru
		</h1>
		<p class="mt-1.5 font-mono text-meta text-primary">software engineer in Iași, Romania</p>
		<p class="mt-5 max-w-[46ch] text-lede font-[350] text-pretty">
			I lead the integrations team at CloudQuery and run a homelab out of my office. This is where I
			write about Kubernetes, security, and whatever broke last weekend.
		</p>
		<SocialList class="mt-6" />
	</div>

	<hero-scene class="group/hero block min-w-0 max-sm:max-w-[480px]" data-scene="day">
		<figure>
			<div class="relative aspect-[4/3]">
				<script
					is:inline
					define:vars={{ zone: IASI_TIME_ZONE, from: NIGHT_FROM, until: NIGHT_UNTIL }}
				>
					const host = document.currentScript?.closest("hero-scene");
					const hour = new Intl.DateTimeFormat("en-GB", {
						timeZone: zone,
						hour: "numeric",
						hourCycle: "h23",
					})
						.formatToParts(new Date())
						.find((p) => p.type === "hour");
					if (host && hour) host.dataset.scene = +hour.value >= from || +hour.value < until ? "night" : "day";
				</script>
				<div
					class="absolute inset-0 transition-opacity duration-200 group-data-[live]/hero:opacity-0 motion-reduce:transition-none"
					data-stills
				>
					<img
						src="/hero/day.avif"
						alt={alt.day}
						{...still}
						loading="lazy"
						decoding="async"
						class="size-full object-contain group-data-[scene=night]/hero:hidden"
					/>
					<picture class="hidden group-data-[scene=night]/hero:contents">
						<source srcset="/hero/night-dark.avif" media="(prefers-color-scheme: dark)" />
						<img
							src="/hero/night-light.avif"
							alt={alt.night}
							{...still}
							loading="lazy"
							decoding="async"
							class="size-full object-contain"
						/>
					</picture>
				</div>
				<canvas
					class="absolute inset-0 size-full cursor-grab touch-pan-y opacity-0 transition-opacity duration-200 group-data-[live]/hero:opacity-100 motion-reduce:transition-none [&.grabbing]:cursor-grabbing"
					role="img"
					aria-hidden="true"
					aria-label={alt.day}></canvas>
			</div>
			<figcaption class="mt-1 flex items-center justify-between gap-4 font-mono text-meta text-muted">
				<span><time data-clock></time> in Iași</span>
				<span class="-me-3 flex">
					<button
						type="button"
						class:list={[control, "inline-flex"]}
						data-toggle
						aria-label="Show night scene"
					>
						<svg
							class="size-5 group-data-[scene=night]/hero:hidden"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
						</svg>
						<svg
							class="hidden size-5 group-data-[scene=night]/hero:block"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							aria-hidden="true"
						>
							<circle cx="12" cy="12" r="4"></circle>
							<path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
							></path>
						</svg>
					</button>
					<button
						type="button"
						class:list={[control, "hidden group-data-[live]/hero:inline-flex"]}
						data-pause
						aria-pressed="false"
						aria-label="Pause animation"
					>
						<svg
							class="size-5 group-data-[paused]/hero:hidden"
							viewBox="0 0 24 24"
							fill="currentColor"
							aria-hidden="true"
						>
							<rect x="6.5" y="5" width="3.5" height="14" rx="1"></rect>
							<rect x="14" y="5" width="3.5" height="14" rx="1"></rect>
						</svg>
						<svg
							class="hidden size-5 group-data-[paused]/hero:block"
							viewBox="0 0 24 24"
							fill="currentColor"
							aria-hidden="true"
						>
							<path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"></path>
						</svg>
					</button>
				</span>
			</figcaption>
		</figure>
	</hero-scene>
</section>

<script>
	import type { Hero } from "@/scripts/hero/stage";
	import { iasiTime, msUntilNextMinute, type Scene, sceneAt } from "@/utils/iasi-time";

	const MODELS = { me: "/models/me.glb", white: "/models/white.glb", tux: "/models/tux.glb" };

	function webgl() {
		try {
			const gl = document.createElement("canvas").getContext("webgl2");
			gl?.getExtension("WEBGL_lose_context")?.loseContext();
			return Boolean(gl);
		} catch {
			return false;
		}
	}

	function canAnimate() {
		const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
		return (
			!window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
			connection?.saveData !== true &&
			webgl()
		);
	}

	function afterLoad(fn: () => void) {
		const idle = () => {
			if (typeof window.requestIdleCallback === "function") window.requestIdleCallback(fn, { timeout: 2000 });
			else setTimeout(fn, 200);
		};
		const ready = () => {
			if (document.readyState === "complete") idle();
			else window.addEventListener("load", idle, { once: true });
		};
		if ((document as Document & { prerendering?: boolean }).prerendering) {
			document.addEventListener("prerenderingchange", ready, { once: true });
		} else ready();
	}

	class HeroScene extends HTMLElement {
		private hero: Hero | null = null;
		private timer = 0;
		private chosen = false;
		private gone = false;
		private readonly cleanups: Array<() => void> = [];

		get scene(): Scene {
			return this.dataset.scene === "night" ? "night" : "day";
		}

		connectedCallback() {
			this.gone = false;
			const canvas = this.querySelector("canvas");
			const toggle = this.querySelector<HTMLButtonElement>("[data-toggle]");
			const pause = this.querySelector<HTMLButtonElement>("[data-pause]");
			if (!canvas || !toggle || !pause) return;
			this.show(sceneAt(new Date()));
			this.tick();

			this.listen(toggle, "click", () => {
				this.chosen = true;
				this.show(this.scene === "night" ? "day" : "night");
			});
			this.listen(pause, "click", () => {
				const paused = pause.getAttribute("aria-pressed") !== "true";
				pause.setAttribute("aria-pressed", String(paused));
				this.toggleAttribute("data-paused", paused);
				this.hero?.setPaused(paused);
			});
			this.listen(this, "pointerenter", () => this.hero?.wake());
			const dark = window.matchMedia("(prefers-color-scheme: dark)");
			this.listen(dark, "change", () => this.hero?.setPalette(dark.matches));

			if (!canAnimate()) return;
			afterLoad(() => {
				const seen = new IntersectionObserver(
					(entries) => {
						if (!entries.some((e) => e.isIntersecting)) return;
						seen.disconnect();
						this.start(canvas, dark.matches);
					},
					{ rootMargin: "200px" },
				);
				seen.observe(this);
				this.cleanups.push(() => seen.disconnect());
			});
		}

		disconnectedCallback() {
			this.gone = true;
			window.clearTimeout(this.timer);
			for (const c of this.cleanups.splice(0)) c();
			this.hero?.dispose();
			this.hero = null;
		}

		private listen(target: EventTarget, type: string, fn: () => void) {
			target.addEventListener(type, fn);
			this.cleanups.push(() => target.removeEventListener(type, fn));
		}

		private show(scene: Scene) {
			this.dataset.scene = scene;
			this.querySelector("[data-toggle]")?.setAttribute(
				"aria-label",
				scene === "night" ? "Show day scene" : "Show night scene",
			);
			this.hero?.show(scene);
		}

		private tick() {
			const now = new Date();
			const clock = this.querySelector<HTMLTimeElement>("[data-clock]");
			if (clock) clock.textContent = iasiTime(now).label;
			if (!this.chosen && sceneAt(now) !== this.scene) this.show(sceneAt(now));
			this.timer = window.setTimeout(() => this.tick(), msUntilNextMinute(now));
		}

		private async start(canvas: HTMLCanvasElement, dark: boolean) {
			try {
				const { createHero } = await import("@/scripts/hero/stage");
				const hero = await createHero({ canvas, scene: this.scene, dark, models: MODELS });
				if (this.gone) {
					hero.dispose();
					return;
				}
				this.hero = hero;
				canvas.removeAttribute("aria-hidden");
				this.toggleAttribute("data-live", true);
				const stills = this.querySelector<HTMLElement>("[data-stills]");
				window.setTimeout(() => stills?.setAttribute("hidden", ""), 250);
			} catch (error) {
				console.warn("hero: showing the still instead of the 3D scene", error);
			}
		}
	}

	if (!customElements.get("hero-scene")) customElements.define("hero-scene", HeroScene);
</script>
