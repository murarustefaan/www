---
import { getAllPosts } from "@/data/post";
import { collectionDateSort } from "@/utils/date";

const allPosts = (await getAllPosts()).sort(collectionDateSort);
const searchData = allPosts.map((post) => ({
	title: post.data.title,
	description: post.data.description,
	tags: post.data.tags,
	url: `/blog/${post.id}/`,
}));
---

<dialog
	id="command-palette"
	aria-label="Search posts"
	class="m-0 size-full max-h-none max-w-none bg-transparent text-text backdrop:bg-bg/80 backdrop:backdrop-blur-sm print:hidden"
	data-posts={JSON.stringify(searchData)}
>
	<div class="relative max-w-xl mx-auto mt-[20vh] px-4">
		<div
			data-panel
			class="bg-card border border-border rounded-lg shadow-2xl shadow-primary/5 overflow-hidden"
		>
			<div class="flex items-center gap-3 px-4 border-b border-border">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted shrink-0" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
				<input
					id="cmd-input"
					type="text"
					role="combobox"
					aria-label="Search posts"
					aria-autocomplete="list"
					aria-expanded="false"
					aria-controls="cmd-results"
					placeholder="Search posts…"
					class="w-full py-3.5 bg-transparent text-text placeholder:text-muted outline-none font-mono text-sm"
					autocomplete="off"
					spellcheck="false"
				/>
				<kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-xs text-muted bg-bg border border-border rounded font-mono">esc</kbd>
			</div>

			<div class="max-h-80 overflow-y-auto">
				<div id="cmd-results" role="listbox" aria-label="Posts"></div>
				<p id="cmd-empty" class="px-4 py-8 text-center text-muted font-mono text-sm" hidden>
					No results.
				</p>
			</div>

			<div class="px-4 py-2 border-t border-border flex items-center gap-4 text-xs text-muted font-mono" aria-hidden="true">
				<span class="flex items-center gap-1">
					<kbd class="px-1 py-0.5 bg-bg border border-border rounded">↑↓</kbd>
					navigate
				</span>
				<span class="flex items-center gap-1">
					<kbd class="px-1 py-0.5 bg-bg border border-border rounded">↵</kbd>
					open
				</span>
				<span class="flex items-center gap-1">
					<kbd class="px-1 py-0.5 bg-bg border border-border rounded">esc</kbd>
					close
				</span>
			</div>
		</div>
	</div>
</dialog>

<script>
	interface Post {
		title: string;
		description: string;
		tags: string[];
		url: string;
	}

	let toggle: (() => void) | null = null;

	function highlight(target: HTMLElement, text: string, query: string) {
		const start = query ? text.toLowerCase().indexOf(query) : -1;
		if (start < 0) {
			target.textContent = text;
			return;
		}
		const mark = document.createElement("span");
		mark.className = "text-primary";
		mark.textContent = text.slice(start, start + query.length);
		target.append(text.slice(0, start), mark, text.slice(start + query.length));
	}

	function createOption(post: Post, index: number, query: string) {
		const option = document.createElement("a");
		option.id = `cmd-option-${index}`;
		option.href = post.url;
		option.tabIndex = -1;
		option.setAttribute("role", "option");
		option.setAttribute("aria-selected", "false");
		option.className =
			"block px-4 py-3 hover:bg-secondary/50 aria-selected:bg-secondary/50 transition-colors";

		const title = document.createElement("div");
		title.className = "text-sm text-text font-mono mb-1";
		highlight(title, post.title, query);

		const description = document.createElement("div");
		description.className = "text-xs text-muted line-clamp-1";
		description.textContent = post.description;

		const tags = document.createElement("div");
		tags.className = "flex gap-1.5 mt-1.5";
		for (const t of post.tags) {
			const tag = document.createElement("span");
			tag.className =
				"text-xs px-1.5 py-0.5 bg-bg border border-border text-accent rounded font-mono";
			tag.textContent = `#${t}`;
			tags.append(tag);
		}

		option.append(title, description, tags);
		return option;
	}

	function initCommandPalette() {
		const dialog = document.getElementById("command-palette") as HTMLDialogElement | null;
		const input = document.getElementById("cmd-input") as HTMLInputElement | null;
		const listbox = document.getElementById("cmd-results");
		const empty = document.getElementById("cmd-empty");
		const panel = dialog?.querySelector("[data-panel]");
		if (!dialog || !input || !listbox || !empty || !panel) {
			toggle = null;
			return;
		}
		if (dialog.dataset.ready) return;
		dialog.dataset.ready = "true";

		const posts: Post[] = JSON.parse(dialog.dataset.posts ?? "[]");
		let options: HTMLAnchorElement[] = [];
		let activeIndex = -1;
		let opener: Element | null = null;
		let pressedOutside = false;

		const setActive = (index: number) => {
			activeIndex = index;
			options.forEach((option, i) => {
				option.setAttribute("aria-selected", String(i === index));
			});
			const active = options[index];
			if (active) {
				input.setAttribute("aria-activedescendant", active.id);
				active.scrollIntoView({ block: "nearest" });
			} else {
				input.removeAttribute("aria-activedescendant");
			}
		};

		const render = (value: string) => {
			const q = value.toLowerCase().trim();
			const filtered = q
				? posts.filter(
						(p) =>
							p.title.toLowerCase().includes(q) ||
							p.description.toLowerCase().includes(q) ||
							p.tags.some((t) => t.includes(q)),
					)
				: posts;

			options = filtered.map((post, i) => createOption(post, i, q));
			listbox.replaceChildren(...options);
			empty.hidden = options.length > 0;
			input.setAttribute("aria-expanded", String(options.length > 0));
			setActive(options.length > 0 ? 0 : -1);
		};

		const open = (from: Element | null) => {
			if (dialog.open) return;
			opener = from;
			input.value = "";
			render("");
			dialog.showModal();
			input.focus();
			document.body.style.overflow = "hidden";
		};

		dialog.addEventListener("close", () => {
			document.body.style.overflow = "";
			if (opener instanceof HTMLElement) opener.focus();
			opener = null;
		});

		input.addEventListener("input", () => render(input.value));

		input.addEventListener("keydown", (e) => {
			if (e.key === "ArrowDown") {
				e.preventDefault();
				setActive(Math.min(activeIndex + 1, options.length - 1));
			} else if (e.key === "ArrowUp") {
				e.preventDefault();
				setActive(Math.max(activeIndex - 1, 0));
			} else if (e.key === "Enter") {
				e.preventDefault();
				options[activeIndex]?.click();
			}
		});

		listbox.addEventListener("click", (e) => {
			if ((e.target as Element).closest("[role='option']")) dialog.close();
		});

		dialog.addEventListener("pointerdown", (e) => {
			pressedOutside = !panel.contains(e.target as Node);
		});

		dialog.addEventListener("click", (e) => {
			if (pressedOutside && !panel.contains(e.target as Node)) dialog.close();
			pressedOutside = false;
		});

		document.getElementById("search-trigger")?.addEventListener("click", (e) => {
			open(e.currentTarget as Element);
		});

		toggle = () => (dialog.open ? dialog.close() : open(document.activeElement));
	}

	document.addEventListener("keydown", (e) => {
		if ((e.metaKey || e.ctrlKey) && e.key === "k") {
			e.preventDefault();
			toggle?.();
		}
	});

	document.addEventListener("astro:page-load", initCommandPalette);
</script>
