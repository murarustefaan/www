---
import { type CollectionEntry, render } from "astro:content";

import Masthead from "@/components/blog/Masthead.astro";
import RelatedPosts from "@/components/blog/RelatedPosts.astro";
import TOC from "@/components/blog/TOC.astro";
import JsonLd from "@/components/JsonLd.astro";
import { personRef } from "@/data/person";

import BaseLayout from "./Base.astro";

interface Props {
	post: CollectionEntry<"post">;
	prevPost?: CollectionEntry<"post"> | undefined;
	nextPost?: CollectionEntry<"post"> | undefined;
}

const { post, prevPost, nextPost } = Astro.props;
const { ogImage, title, description, updatedDate, publishDate, tags } = post.data;
const socialImage = ogImage ?? `/og-image/${post.id}.png`;
const articleDate = publishDate.toISOString();
const articleModified = updatedDate?.toISOString();
const { headings, remarkPluginFrontmatter } = await render(post);
const readingTime: string = remarkPluginFrontmatter.readingTime;
const wordCount: number | undefined = remarkPluginFrontmatter.wordCount;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const socialImageURL = new URL(socialImage, Astro.url).href;

const blogPostingSchema = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: title,
	description,
	url: canonicalURL,
	image: socialImageURL,
	datePublished: articleDate,
	dateModified: articleModified ?? articleDate,
	...(wordCount && { wordCount }),
	author: personRef,
	publisher: personRef,
	...(tags?.length && { keywords: tags.join(", ") }),
	mainEntityOfPage: {
		"@type": "WebPage",
		"@id": canonicalURL,
	},
};
---

<BaseLayout
	meta={{
		articleDate,
		articleModified,
		description,
		imageAlt: title,
		ogImage: socialImage,
		readingTime,
		title,
	}}
>
	<JsonLd schema={blogPostingSchema} />

	{/* Reading progress bar */}
	<div class="sticky top-14 z-40 h-0.5 bg-border/30">
		<div id="reading-progress" class="h-full bg-primary transition-[width] duration-150 ease-out" style="width: 0%" />
	</div>

	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
		{/* Back link */}
		<a
			href="/blog/"
			class="inline-flex min-h-11 items-center gap-2 text-muted hover:text-primary transition-colors mb-8 font-mono text-sm"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
			<span>all writing</span>
		</a>

		<article class="grow break-words">
			<div id="blog-hero" class="mb-12">
				<Masthead content={post} readingTime={readingTime} />
			</div>

			<div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
				{!!headings.length && <TOC headings={headings} />}
				<div class="prose max-w-none">
					<slot />
				</div>
			</div>
		</article>

		{/* Related posts */}
		<RelatedPosts currentPost={post} />

		{/* Post navigation */}
		<nav aria-label="Post navigation" class="mt-16 pt-8 border-t border-border">
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				{prevPost ? (
					<a
						href={`/blog/${prevPost.id}/`}
						class="group p-4 bg-card border border-border rounded-lg hover:border-primary/30 transition-all card-hover"
					>
						<div class="font-mono text-xs text-muted mb-2">Previous</div>
						<div class="text-text group-hover:text-primary transition-colors">{prevPost.data.title}</div>
					</a>
				) : <div />}
				{nextPost && (
					<a
						href={`/blog/${nextPost.id}/`}
						class="group p-4 bg-card border border-border rounded-lg hover:border-primary/30 transition-all card-hover sm:text-right"
					>
						<div class="font-mono text-xs text-muted mb-2">Next</div>
						<div class="text-text group-hover:text-primary transition-colors">{nextPost.data.title}</div>
					</a>
				)}
			</div>
			<a
				href="/blog/"
				class="inline-flex min-h-11 items-center gap-2 text-muted hover:text-primary transition-colors font-mono text-sm mt-6"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
				<span>all writing</span>
			</a>
		</nav>
	</div>

	{/* Scroll to top */}
	<button
		class="print:hidden z-90 fixed bottom-8 end-4 flex h-10 w-10 translate-y-28 cursor-pointer items-center justify-center rounded-full border border-border bg-card text-muted opacity-0 transition-all duration-300 hover:border-primary hover:text-primary data-[show=true]:translate-y-0 data-[show=true]:opacity-100 sm:end-8 sm:h-12 sm:w-12"
		data-show="false"
		id="to-top-btn"
	>
		<span class="sr-only">Back to top</span>
		<svg
			aria-hidden="true"
			class="h-5 w-5"
			fill="none"
			focusable="false"
			stroke="currentColor"
			stroke-width="2"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path d="M4.5 15.75l7.5-7.5 7.5 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
	</button>
</BaseLayout>

<script>
	const progressBar = document.getElementById("reading-progress") as HTMLDivElement;
	const article = document.querySelector("article") as HTMLElement;

	function updateProgress() {
		const rect = article.getBoundingClientRect();
		const total = article.scrollHeight - window.innerHeight;
		const progress = Math.min(100, Math.max(0, (-rect.top / total) * 100));
		progressBar.style.width = `${progress}%`;
	}

	window.addEventListener("scroll", updateProgress, { passive: true });
	updateProgress();
</script>

<script>
	const scrollBtn = document.getElementById("to-top-btn") as HTMLButtonElement;
	const targetHeader = document.getElementById("blog-hero") as HTMLDivElement;

	function callback(entries: IntersectionObserverEntry[]) {
		entries.forEach((entry) => {
			scrollBtn.dataset.show = (!entry.isIntersecting).toString();
		});
	}

	scrollBtn.addEventListener("click", () => {
		document.documentElement.scrollTo({ behavior: "smooth", top: 0 });
	});

	const observer = new IntersectionObserver(callback);
	observer.observe(targetHeader);
</script>
